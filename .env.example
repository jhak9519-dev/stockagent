# === 이 파일을 복사해서 ".env" 로 저장한 뒤, 실제 키 값을 채우세요 ===
# (.env 는 절대 외부에 공유하지 마세요. .gitignore 로 제외되어 있습니다.)

# --- AI 엔진 선택 ---
# auto        = 있는 키를 자동 선택 (claude 우선 → gemini → 없으면 규칙 기반)
# claude      = Anthropic Claude API (유료 종량제 키 필요)
# gemini      = Google Gemini API (무료 티어)
# claude_code = 로컬 Claude Code(`claude -p`)를 구독으로 호출 (API 키 불필요, Max/Pro 구독 사용)
# rule        = AI 없이 규칙 기반 요약만
LLM_PROVIDER=auto

# --- Claude 사용 시 (선택) ---
# Anthropic Claude API 키 — https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Gemini 사용 시 (무료 티어 가능) ---
# Google AI Studio 키 — https://aistudio.google.com/apikey 에서 무료 발급
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# DART Open API 키 (한국 재무제표 수집에 필요) — https://opendart.fss.or.kr 에서 발급
DART_API_KEY=

# --- 카카오톡 알림 (선택) ---
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REFRESH_TOKEN=

# --- 이메일 발송 (네이버 SMTP, 선택) ---
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_TO=